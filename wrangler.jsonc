// Cloudflare deploy: the built site in dist/ served as static files; any unknown path gets index.html, whose router shows the
// 404 page. /api/* goes to the worker (the contact form) before the files are checked.
{
  "name": "mohak-shah",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
